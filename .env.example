# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine (Covered) | baton
AGENT_PROFILE=mine
# Which models: budget | quality   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent
